# Shared SSH config. Machine-specific hosts (company servers, jump hosts, VM tools)
# live in ~/.ssh/config.d/, which is not tracked.
Include ~/.ssh/config.d/*

Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519

Host *
  IgnoreUnknown UseKeychain
  UseKeychain yes
  AddKeysToAgent yes
  IdentitiesOnly yes
  PreferredAuthentications publickey
  IPQoS lowdelay
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist 10m
