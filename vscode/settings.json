// VS Code user settings for the default profile (Ruby, PHP, React), linked by bootstrap.sh.
// Theme and fonts match the terminal (Alacritty, kitty): Rosé Pine Moon, Cascadia Code NF.
{
  // ── Shared with every profile (Go, Python, Vue, ...) ────────────────────────
  "workbench.settings.applyToAllProfiles": [
    "workbench.colorTheme",
    "workbench.iconTheme",
    "window.autoDetectColorScheme",
    "editor.fontFamily",
    "editor.fontSize",
    "editor.fontWeight",
    "editor.lineHeight",
    "editor.letterSpacing",
    "editor.fontLigatures",
    "terminal.integrated.fontFamily",
    "terminal.integrated.fontSize",
    "terminal.integrated.fontWeight",
    "terminal.integrated.letterSpacing",
    "terminal.integrated.lineHeight",
    "telemetry.telemetryLevel",
    "files.watcherExclude",
    "search.exclude",
    "search.followSymlinks"
  ],

  // ── Theme and fonts ─────────────────────────────────────────────────────────
  "workbench.colorTheme": "Rosé Pine Moon (no italics)",
  "workbench.iconTheme": "catppuccin-frappe",
  // Keep Rosé Pine; following the OS light/dark setting switched to Dark Modern
  "window.autoDetectColorScheme": false,
  // Cascadia Code is 0.586em wide: 14px + 0.8 spacing gives 9px columns, as in Alacritty.
  // A fractional width (13.5 + 0.4 = 8.32px) leaves gaps of 8 and 9px between letters,
  // so change fontSize and letterSpacing together.
  "editor.fontFamily": "CaskaydiaCove Nerd Font, 'Cascadia Code NF', monospace",
  // No ligatures and 20px lines, as in Alacritty
  "editor.fontWeight": "400",
  "editor.lineHeight": 1.55,
  "editor.letterSpacing": 0.8,
  "editor.fontLigatures": false,
  // The terminal rounds cells down to 8x16px; these make Alacritty's 9x18px cells
  "terminal.integrated.fontFamily": "CaskaydiaCove Nerd Font, 'Cascadia Code NF'",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.fontWeight": "normal",
  "terminal.integrated.letterSpacing": 1,
  "terminal.integrated.lineHeight": 1.125,
  "debug.console.fontSize": 13,
  "markdown.preview.fontFamily": "'CaskaydiaCove Nerd Font', 'Segoe UI', sans-serif",
  "markdown.preview.fontSize": 13,
  // ── Window and workbench ────────────────────────────────────────────────────
  "window.titleBarStyle": "custom",
  "window.dialogStyle": "custom",
  "window.menuBarVisibility": "classic",
  "window.commandCenter": true,
  "window.title": "${rootName}",
  "window.density.editorTabHeight": "compact",
  "workbench.startupEditor": "none",
  "workbench.activityBar.location": "top",
  "workbench.list.smoothScrolling": true,
  "workbench.tree.indent": 10,
  "workbench.tree.expandMode": "doubleClick",
  "workbench.editor.tabActionLocation": "left",
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.closeOnFileDelete": true,
  // Close the oldest unpinned tab beyond 5 per group: fewer open models, steady memory
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.editor.limit.value": 5,
  "files.simpleDialog.enable": true,
  "breadcrumbs.enabled": true,
  "chat.commandCenter.enabled": false,

  // ── Editor ──────────────────────────────────────────────────────────────────
  "editor.tabSize": 2,
  "editor.wordWrap": "on",
  "editor.renderWhitespace": "none",
  "editor.smoothScrolling": true,
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": true,
  "editor.hover.sticky": true,
  // Shown while Ctrl+Alt is held, so language servers aren't asked on every scroll
  "editor.inlayHints.enabled": "offUnlessPressed",
  "editor.inlineSuggest.enabled": true,
  "editor.suggestSelection": "first",
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.find.addExtraSpaceOnTop": false,
  "editor.unicodeHighlight.invisibleCharacters": false,
  // No $ so a double click selects a whole PHP or shell variable
  "editor.wordSeparators": "`~!@#%^&*()-=+[{]}\\|;:'\",.<>/?",
  // Renames the closing tag with the opening one (HTML, JSX), replacing auto-rename-tag
  "editor.linkedEditing": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "emmet.showSuggestionsAsSnippets": true,
  "emmet.triggerExpansionOnTab": false,

  // ── Files ───────────────────────────────────────────────────────────────────
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "files.autoSave": "onFocusChange",

  // ── Performance ─────────────────────────────────────────────────────────────
  "telemetry.telemetryLevel": "off",
  // Not watched: dependencies, build output, logs and caches. Saves file-watcher CPU
  // and the events every extension would otherwise react to.
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/vendor/**": true,
    "**/.bundle/**": true,
    "**/tmp/**": true,
    "**/log/**": true,
    "**/storage/framework/**": true,
    "**/storage/logs/**": true,
    "**/bootstrap/cache/**": true,
    "**/public/build/**": true,
    "**/public/packs/**": true,
    "**/public/assets/**": true,
    "**/.next/**": true,
    "**/dist/**": true,
    "**/coverage/**": true
  },
  // Not searched by default (toggle "Use Exclude Settings" in Search to include them)
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/vendor": true,
    "**/.bundle": true,
    "**/tmp": true,
    "**/log": true,
    "**/logs": true,
    "**/storage/framework": true,
    "**/storage/logs": true,
    "**/bootstrap/cache": true,
    "**/public/build": true,
    "**/public/packs": true,
    "**/.next": true,
    "**/dist": true,
    "**/out": true,
    "**/coverage": true,
    "**/*.snap": true,
    "**/package-lock.json": true,
    "**/yarn.lock": true,
    "**/pnpm-lock.yaml": true
  },
  "search.followSymlinks": false,
  // React projects have node_modules; don't download @types in the background
  "typescript.disableAutomaticTypeAcquisition": true,

  // ── Formatting: only for projects that configure a formatter ────────────────
  "editor.formatOnSave": false,
  "prettier.requireConfig": true,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" }
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" }
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" }
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },

  // ── PHP (Intelephense; Laravel runs in Sail, there is no local php) ─────────
  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
    "editor.tabSize": 4
  },
  "[blade]": {
    "editor.tabSize": 4
  },
  // Built-in PHP support duplicates Intelephense and runs `php -l`, which isn't installed
  "php.suggest.basic": false,
  "php.validate.enable": false,
  "intelephense.telemetry.enabled": false,
  // Defaults plus Laravel's compiled views and caches
  "intelephense.files.exclude": [
    "**/.git/**",
    "**/.svn/**",
    "**/.hg/**",
    "**/CVS/**",
    "**/.DS_Store/**",
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**/{Tests,tests}/**",
    "**/.history/**",
    "**/vendor/**/vendor/**",
    "**/storage/framework/**",
    "**/bootstrap/cache/**"
  ],

  // ── Terminal ────────────────────────────────────────────────────────────────
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "terminal.integrated.initialHint": false,
  // lazygit as a terminal profile, opened as an editor tab with Ctrl+Alt+G (keybindings.json)
  "terminal.integrated.profiles.linux": {
    "lazygit": { "path": "lazygit", "icon": "git-branch" }
  },
  "terminal.integrated.profiles.osx": {
    "lazygit": { "path": "lazygit", "icon": "git-branch" }
  },

  // ── Git ─────────────────────────────────────────────────────────────────────
  "git.autofetch": true,
  "git.autofetchPeriod": 180,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.untrackedChanges": "separate",
  "scm.diffDecorationsGutterWidth": 2,
  "merge-conflict.autoNavigateNextConflict.enabled": true,
  // Built-in blame instead of GitLens: last change of the current line, dimmed at its end
  "git.blame.editorDecoration.enabled": true,

  // ── Misc ────────────────────────────────────────────────────────────────────
  "http.proxySupport": "off",
  "debug.onTaskErrors": "debugAnyway",
  "explorer.confirmDelete": true,
  "explorer.confirmDragAndDrop": true,
  "claudeCode.preferredLocation": "panel",
  "settingsSync.ignoredExtensions": [
    "mechatroner.rainbow-csv",
    "github.copilot",
    "github.copilot-chat"
  ],
  "workbench.editor.editorActionsLocation": "titleBar",
  "extensions.ignoreRecommendations": true,
  "editor.fontSize": 13,
}
